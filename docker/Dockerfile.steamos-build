FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Install base tools needed to run Ladybird's own install-build-dependencies.sh
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    sudo \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
